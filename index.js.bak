const readJadiBotProfile = (sessionDir = "", fallbackNumber = "") => {
  const defaultProfile = {
    mode: "standard",
    ownerNumber: "",
    ownerName: "",
    phoneNumber: normalizeJadiBotNumber(fallbackNumber),
    botName: "",
    botPhoto: ""
  }
  if (!sessionDir) return defaultProfile
  const profileFile = path.join(sessionDir, jadiBotProfileFileName)
  if (!fs.existsSync(profileFile)) return defaultProfile

  try {
    const raw = JSON.parse(fs.readFileSync(profileFile, "utf8"))
    return {
      mode: normalizeJadiBotMode(raw?.mode),
      ownerNumber: normalizeJadiBotNumber(raw?.ownerNumber || ""),
      ownerName: String(raw?.ownerName || "").trim(),
      phoneNumber: normalizeJadiBotNumber(raw?.phoneNumber || fallbackNumber || ""),
      botName: String(raw?.botName || "").trim(),
      botPhoto: String(raw?.botPhoto || "").trim()
    }
  } catch {
    return defaultProfile
  }
}

const writeJadiBotProfile = (sessionDir = "", profile = {}) => {
  if (!sessionDir) return
  const profileFile = path.join(sessionDir, jadiBotProfileFileName)
  const normalized = {
    mode: normalizeJadiBotMode(profile?.mode),
    ownerNumber: normalizeJadiBotNumber(profile?.ownerNumber || ""),
    ownerName: String(profile?.ownerName || "").trim(),
    phoneNumber: normalizeJadiBotNumber(profile?.phoneNumber || ""),
    botName: String(profile?.botName || "").trim(),
    botPhoto: String(profile?.botPhoto || "").trim()
  }
  fs.writeFileSync(profileFile, JSON.stringify(normalized, null, 2))
}

function attachSocketRuntime(sock, storeRef) {
  const sanitizeJidList = (value) => {
    if (!Array.isArray(value)) return []
    return value
      .map((jid) => (typeof jid === 'string' ? jid.trim() : ''))
      .filter((jid) => jid && /@/.test(jid))
  }

  const sanitizeSendContent = (content) => {
    if (!content || typeof content !== 'object') return content
    if (Array.isArray(content.mentions)) {
      content.mentions = sanitizeJidList(content.mentions)
    }
    if (content.contextInfo && typeof content.contextInfo === 'object' && Array.isArray(content.contextInfo.mentionedJid)) {
      content.contextInfo.mentionedJid = sanitizeJidList(content.contextInfo.mentionedJid)
    }
    return content
  }

  const sanitizeSendOptions = (options) => {
    if (!options || typeof options !== 'object') return options
    if (Array.isArray(options.statusJidList)) {
      options.statusJidList = sanitizeJidList(options.statusJidList)
    }
    return options
  }

  const rawSendMessage = sock.sendMessage.bind(sock)
  sock.sendMessage = async (jid, content = {}, options = {}) => {
    const targetJid = typeof jid === 'string' ? jid.trim() : ''
    if (!targetJid) {
      console.log('[Baileys] Skip sendMessage: jid tidak valid')
      return null
    }
    return rawSendMessage(
      targetJid,
      sanitizeSendContent(content),
      sanitizeSendOptions(options)
    )
  }

  sock.decodeJid = (jid) => {
    if (!jid) return jid
    if (/:\d+@/gi.test(jid)) {
      const decode = jidDecode(jid) || {}
      return (decode.user && decode.server) ? `${decode.user}@${decode.server}` : jid
    }
    return jid
  }

  sock.sendText = (jid, text, quoted = "", options = {}) =>
    sock.sendMessage(jid, { text, ...options }, { quoted })

  sock.sendTextWithMentions = async (jid, text, quoted, options = {}) =>
    sock.sendMessage(
      jid,
      {
        text,
        contextInfo: {
          mentionedJid: [...text.matchAll(/@(\d{0,16})/g)].map(v => `${v[1]}@s.whatsapp.net`)
        },
        ...options
      },
      { quoted }
    )

  sock.deleteMessage = async (chatId, key) => {
    try {
      await sock.sendMessage(chatId, { delete: key })
    } catch {}
  }

  sock.downloadMediaMessage = async (message) => {
    const mime = (message.msg || message).mimetype || ""
    const messageType = message.mtype ? message.mtype.replace(/Message/gi, "") : mime.split("/")[0]
    const stream = await downloadContentFromMessage(message, messageType)
    let buffer = Buffer.from([])
    for await (const chunk of stream) buffer = Buffer.concat([buffer, chunk])
    return buffer
  }

  sock.sendImage = async (jid, mediaPath, caption = "", quoted = "", options = {}) => {
    const buffer = Buffer.isBuffer(mediaPath)
      ? mediaPath
      : /^data:.*?\/.*?;base64,/i.test(mediaPath)
      ? Buffer.from(mediaPath.split(",")[1], "base64")
      : /^https?:\/\//.test(mediaPath)
      ? await getBuffer(mediaPath)
      : fs.existsSync(mediaPath)
      ? fs.readFileSync(mediaPath)
      : Buffer.alloc(0)

    return sock.sendMessage(jid, { image: buffer, caption, ...options }, { quoted })
  }

  sock.sendImageAsSticker = async (jid, mediaPath, quoted, options = {}) => {
    const buff = Buffer.isBuffer(mediaPath)
      ? mediaPath
      : /^data:.*?\/.*?;base64,/i.test(mediaPath)
      ? Buffer.from(mediaPath.split(",")[1], "base64")
      : /^https?:\/\//.test(mediaPath)
      ? await getBuffer(mediaPath)
      : fs.existsSync(mediaPath)
      ? fs.readFileSync(mediaPath)
      : Buffer.alloc(0)

    const buffer = (options.packname || options.author) ? await writeExifImg(buff, options) : await imageToWebp(buff)
    await sock.sendMessage(jid, { sticker: { url: buffer }, ...options }, { quoted })
    return buffer
  }

  sock.sendVideoAsSticker = async (jid, mediaPath, quoted, options = {}) => {
    const buff = Buffer.isBuffer(mediaPath)
      ? mediaPath
      : /^data:.*?\/.*?;base64,/i.test(mediaPath)
      ? Buffer.from(mediaPath.split(",")[1], "base64")
      : /^https?:\/\//.test(mediaPath)
      ? await getBuffer(mediaPath)
      : fs.existsSync(mediaPath)
      ? fs.readFileSync(mediaPath)
      : Buffer.alloc(0)

    const buffer = (options.packname || options.author) ? await writeExifVid(buff, options) : await videoToWebp(buff)
    await sock.sendMessage(jid, { sticker: { url: buffer }, ...options }, { quoted })
    return buffer
  }

  sock.downloadAndSaveMediaMessage = async (message, filename, attachExtension = true) => {
    const quoted = message.msg ? message.msg : message
    const mime = (message.msg || message).mimetype || ""
    const messageType = message.mtype ? message.mtype.replace(/Message/gi, "") : mime.split("/")[0]
    const stream = await downloadContentFromMessage(quoted, messageType)
    let buffer = Buffer.from([])
    for await (const chunk of stream) buffer = Buffer.concat([buffer, chunk])

    const type = await FileType.fromBuffer(buffer) || { ext: "bin" }
    const trueFileName = attachExtension ? `${filename}.${type.ext}` : filename
    fs.writeFileSync(trueFileName, buffer)
    return trueFileName
  }

  sock.getFile = async (PATH, save) => {
    let res
    let filename
    const data = Buffer.isBuffer(PATH)
      ? PATH
      : /^data:.*?\/.*?;base64,/i.test(PATH)
      ? Buffer.from(PATH.split(",")[1], "base64")
      : /^https?:\/\//.test(PATH)
      ? await (res = await getBuffer(PATH))
      : fs.existsSync(PATH)
      ? (filename = PATH, fs.readFileSync(PATH))
      : typeof PATH === "string"
      ? Buffer.from(PATH)
      : Buffer.alloc(0)

    const type = await FileType.fromBuffer(data) || {
      mime: "application/octet-stream",
      ext: "bin"
    }

    if (!filename) filename = path.join(__dirname, "tmp", `${Date.now()}.${type.ext}`)
    if (data && save) await fs.promises.writeFile(filename, data)

    return {
      res,
      filename,
      size: await getSizeMedia(data),
      ...type,
      data
    }
  }

  sock.sendFile = async (jid, PATH, fileName, quoted = {}, options = {}) => {
    const types = await sock.getFile(PATH, true)
    const { filename, ext, mime, data } = types
    let type = ""
    let mimetype = mime
    let pathFile = filename

    if (options.asDocument) type = "document"
    else if (options.asSticker || /webp/.test(mime)) {
      const media = { mimetype: mime, data }
      const { writeExif } = require("./ElainaLibray/exif.js")
      pathFile = await writeExif(media, { packname: global.packname, author: global.packname2, categories: options.categories || [] })
      await fs.promises.unlink(filename)
      type = "sticker"
      mimetype = "image/webp"
    } else if (/image/.test(mime)) type = "image"
    else if (/video/.test(mime)) type = "video"
    else if (/audio/.test(mime)) type = "audio"
    else type = "document"

    await sock.sendMessage(jid, { [type]: { url: pathFile }, mimetype, fileName, ...options }, { quoted, ...options })
    return fs.promises.unlink(pathFile)
  }

  sock.copyNForward = async (jid, message, forceForward = false, options = {}) => {
    let vtype
    if (options.readViewOnce) {
      message.message = message.message?.ephemeralMessage?.message || message.message
      vtype = Object.keys(message.message.viewOnceMessage.message)[0]
      delete message.message.viewOnceMessage.message[vtype].viewOnce
      message.message = { ...message.message.viewOnceMessage.message }
    }

    const mtype = Object.keys(message.message)[0]
    const content = await generateForwardMessageContent(message, forceForward)
    const ctype = Object.keys(content)[0]
    let context = {}
    if (mtype !== "conversation") context = message.message[mtype].contextInfo

    content[ctype].contextInfo = {
      ...context,
      ...content[ctype].contextInfo
    }

    const waMessage = await generateWAMessageFromContent(
      jid,
      content,
      options
        ? {
            ...content[ctype],
            ...options,
            ...(options.contextInfo
              ? {
                  contextInfo: {
                    ...content[ctype].contextInfo,
                    ...options.contextInfo
                  }
                }
              : {})
          }
        : {}
    )

    await sock.relayMessage(jid, waMessage.message, { messageId: waMessage.key.id })
    return waMessage
  }

  sock.sendInteractive = async (jid, btn, Img = null, footer = "", title = "", quoted = "", options = {}) => {
    const imagePayload = Img
      ? (Buffer.isBuffer(Img) ? Img : (typeof Img === "string" ? { url: Img } : Img))
      : null
    const header = Img
      ? proto.Message.InteractiveMessage.Header.create({
          title: "",
          hasMediaAttachment: true,
          ...(await prepareWAMessageMedia({ image: imagePayload }, { upload: sock.waUploadToServer }))
        })
      : proto.Message.InteractiveMessage.Header.create({
          title: "",
          hasMddiaAttachment: false
        })

    const msg = generateWAMessageFromContent(jid, {
      viewOnceMessage: {
        message: {
          messageContextInfo: {
            deviceListMetadata: {},
            deviceListMetadataVersion: 2
          },
          interactiveMessage: proto.Message.InteractiveMessage.create({
            ...options,
            body: proto.Message.InteractiveMessage.Body.create({ text: title }),
            footer: proto.Message.InteractiveMessage.Footer.create({ text: footer }),
            header,
            nativeFlowMessage: proto.Message.InteractiveMessage.NativeFlowMessage.create({ buttons: btn })
          })
        }
      }
    }, { quoted })

    await sock.relayMessage(msg.key.remoteJid, msg.message, { messageId: msg.key.id })
  }

  sock.sendStatusMention = async (content, jids = []) => {
    let users = []
    for (const id of jids) {
      const userId = await sock.groupMetadata(id)
      users = userId.participants.map(u => sock.decodeJid(u.id))
    }

    const message = await sock.sendMessage(
      "status@broadcast",
      content,
      {
        backgroundColor: "F54242",
        font: Math.floor(Math.random() * 9),
        statusJidList: users
      }
    )

    for (const id of jids) {
      await sock.relayMessage(
        id,
        {
          groupStatusMentionMessage: {
            message: {
              protocolMessage: {
                key: message.key,
                type: 25
              }
            }
          }
        },
        { userJid: sock.user?.id || sock.user?.jid }
      )
    }
    return message
  }

  sock.getName = (jid, withoutContact = false) => {
    const id = sock.decodeJid(jid)
    withoutContact = sock.withoutContact || withoutContact
    let v
    if (id.endsWith("@g.us")) {
      return new Promise(async (resolve) => {
        v = (storeRef.contacts && storeRef.contacts[id]) ? storeRef.contacts[id] : {}
        if (!(v.name || v.subject)) v = await sock.groupMetadata(id).catch(() => ({}))
        resolve(v.name || v.subject || PhoneNumber("+" + id.replace("@s.whatsapp.net", "")).getNumber("international"))
      })
    }

    v = id === "0@s.whatsapp.net"
      ? { id, name: "WhatsApp" }
      : id === sock.decodeJid(sock.user.id)
      ? sock.user
      : ((storeRef.contacts && storeRef.contacts[id]) || {})

    return (withoutContact ? "" : v.name) || v.subject || v.verifiedName || PhoneNumber("+" + jid.replace("@s.whatsapp.net", "")).getNumber("international")
  }

  sock.serializeM = (m) => smsg(sock, m, storeRef)
}

async function AliceConnect() {
  // ——— License Verification ———
  const licenseFile = path.join(__dirname, 'license.key')
  let licenseKey = global.licenseKey || ''

  // Try reading from file
  if (!licenseKey && fs.existsSync(licenseFile)) {
    try {
      licenseKey = fs.readFileSync(licenseFile, 'utf8').trim()
    } catch {}
  }

  // If still empty, prompt user
  if (!licenseKey) {
    console.log('\n╔══════════════════════════════════════╗')
    console.log('║  LICENSE KEY BELUM DIISI             ║')
    console.log('╠══════════════════════════════════════╣')
    console.log('║  HWID server ini:                    ║')
    console.log(('║  ' + global._HWID().padEnd(36) + '║'))
    console.log('╠══════════════════════════════════════╣')
    console.log('║  Kirim HWID ini ke developer         ║')
    console.log('║  untuk dapatkan license key           ║')
    console.log('╚══════════════════════════════════════╝')
    console.log('Masukkan license key dari developer (atau kosongkan untuk exit):')
    const rl = readline.createInterface({ input: process.stdin, output: process.stdout })
    licenseKey = await new Promise((resolve) => {
      rl.question('> ', (answer) => { rl.close(); resolve(answer.trim()) })
    })
    if (licenseKey) {
      try { fs.writeFileSync(licenseFile, licenseKey, 'utf8') } catch {}
    }
  }

  if (licenseKey) {
    const licenseData = global._VERIFY_LICENSE(licenseKey)
    if (licenseData) {
      console.log('✓ License valid: ' + licenseData.user + ' | HWID: ' + global._HWID())
    } else {
      console.log('✗ License tidak valid! Bot akan exit.')
      if (fs.existsSync(licenseFile)) {
        try { fs.unlinkSync(licenseFile) } catch {}
      }
      process.exit(1)
    }
  } else {
    console.log('! License key tidak boleh kosong.')
    process.exit(1)
  }
  // Override global licenseKey for rest of the system
  global.licenseKey = licenseKey

  // ——— Set Elaina mutual auth handler BEFORE socket creation ———
  const crypto = require('crypto')
  globalThis.__EL_VERIFY = (challenge) => {
    try {
      const lic = global._VERIFY_LICENSE(global.licenseKey)
      if (!lic) return null
      return crypto.createHash('sha256').update(Buffer.concat([challenge, Buffer.from(global.licenseKey)])).digest()
    } catch { return null }
  }
  // ——— End mutual auth ———

  // ——— End License ———

  if (global.__mainConnectPromise) {
    return global.__mainConnectPromise
  }

  global.__mainConnectPromise = (async () => {
    await bootstrapDatabasePromise
    ensureBootstrapDatabaseMaintenance()
    const { state, saveCreds } = await useMultiFileAuthState(`./ElainaSessions`);
    const version = await resolveBaileysStartupVersion()

    const usePairingCode = global.usePairingCode !== false;

    const Alice = makeWASocket({
      logger: pino({ level: "silent" }),
      printQRInTerminal: !usePairingCode,
      auth: {
        creds: state.creds,
        keys: makeCacheableSignalKeyStore(
          state.keys,
          pino().child({ level: "silent", stream: "store" })
        ),
      },
      version,
      browser: ["Ubuntu", "Chrome", "20.0.00"],
      syncFullHistory: true,
      markOnlineOnConnect: true,
      connectTimeoutMs: 60000,
      defaultQueryTimeoutMs: 0,
      keepAliveIntervalMs: 10000,
      generateHighQualityLinkPreview: true,
    });
    Alice.public = true
    global.__mainAliceSocket = Alice

    let mainSocketHasOpened = false
    let mainSocketClosed = false

  Alice.ev.on("connection.update", (update) => {
    if (global.__mainAliceSocket && global.__mainAliceSocket !== Alice) return
    if (update?.connection === "open") mainSocketHasOpened = true
    if (update?.connection === "close") mainSocketClosed = true
  })

    require("./ElainaLibray/welcomeleft")(Alice)

    Alice.ev.on("group-participants.update", (update) => {
      const jid = update?.id
      if (jid && global.__elainaGroupMetadataCache?.has(jid)) {
        global.__elainaGroupMetadataCache.delete(jid)
      }
    })
    
    // Pairing code
    const mainSessionRegistered = !!state?.creds?.registered || !!Alice?.authState?.creds?.registered
    const customPairingKey = normalizeCustomPairingKey(global.pairing)
    if (usePairingCode && !mainSessionRegistered) {
      try {
        const code = await requestMainPairingCodeWithRetry(
          Alice,
          global.AliceBot,
          customPairingKey,
          () => mainSocketClosed || isSocketUnavailable(Alice)
        )

        if (code) {
          console.log(`Your pairing code: ${code}`)
        }
      } catch (error) {
        if (isMainPairingTransientError(error)) {
          console.log(`[MainBot] Pairing/sesi belum final (${error?.message || "connection failure"}), mencoba koneksi ulang...`)
          scheduleMainReconnect("Pairing/sesi belum final", 7000)
        } else {
          throw error
        }
      }
    }

    attachSocketRuntime(Alice, store)

    // Verify Baileys has our guard
    if (typeof Alice._elainaGuard !== 'function') {
      console.log('⚠ Elaina Guard tidak terdeteksi, beberapa fitur mungkin terbatas')
    }
    // ——— End Elaina mutual auth ———

  const processSocketMessages = (sock, chatUpdate) => {
    try {
      const mek = chatUpdate.messages?.[0]
      if (!mek || !mek.message) return
      mek.message = (Object.keys(mek.message)[0] === "ephemeralMessage") ? mek.message.ephemeralMessage.message : mek.message
      if (mek.key && mek.key.remoteJid === "status@broadcast") return
      const remoteJid = normalizeJadiBotGroupJid(mek.key?.remoteJid || "")
      if (sock?.jadiBotProfile && getJadiBotMainBotOnlyGroups().has(remoteJid)) return
      if (normalizeJadiBotMode(sock?.jadiBotProfile?.mode) === "push") {
        sock.public = false
      }
      if (!sock.public && chatUpdate.type === "notify") {
        const rawSender = String(mek.key?.participant || mek.key?.remoteJid || "")
        const senderNumber = normalizeJadiBotNumber(rawSender.split("@")[0] || "")
        const pushOwnerNumber = normalizeJadiBotNumber(sock?.jadiBotProfile?.ownerNumber || "")
        const isPushMode = normalizeJadiBotMode(sock?.jadiBotProfile?.mode) === "push"
        const isPushOwner = isPushMode && !!pushOwnerNumber && senderNumber === pushOwnerNumber
        if (!mek.key.fromMe && !mek.key.isOwner && !isPushOwner) return
      }
      if (mek.key.id.startsWith("BAE5") && mek.key.id.length === 16) return
      const m = smsg(sock, mek, store)
      require("./Elaina")(sock, m, chatUpdate, store)
    } catch (err) {
      console.log(err)
    }
  }

  const deleteJadiBotSession = async (sessionDir) => {
    if (!sessionDir) return
    try {
      await fs.promises.rm(sessionDir, { recursive: true, force: true })
    } catch {
      try { fs.rmSync(sessionDir, { recursive: true, force: true }) } catch {}
    }
  }

  const stopJadiBotClient = async (rawPhone) => {
    const phoneNumber = normalizeJadiBotNumber(rawPhone)
    const current = global.jadiBotClients.get(phoneNumber)
    if (!current) return { ok: false, message: `JadiBot ${phoneNumber} tidak ditemukan.` }

    try {
      if (current.reconnectTimer) clearTimeout(current.reconnectTimer)
      current.manualStop = true
      current.status = "stopped"
      if (typeof current.socket?.end === "function") {
        current.socket.end(new Error("manual stop jadibot"))
      } else if (typeof current.socket?.ws?.close === "function") {
        current.socket.ws.close()
      }
    } catch {}

    global.jadiBotClients.delete(phoneNumber)
    global.jadiBotRetryCount.delete(phoneNumber)
    for (const [chatId, num] of global.jadiBotLastByChat.entries()) {
      if (num === phoneNumber) global.jadiBotLastByChat.delete(chatId)
    }
    await deleteJadiBotSession(current.sessionDir)
    return { ok: true, message: `JadiBot ${phoneNumber} dihentikan.` }
  }

  const startJadiBotClient = async (rawPhone, notifyChat = null, options = {}) => {
    const {
      requestPairing = true,
      force = false,
      preserveSessionOnError = false,
      mode = "standard",
      ownerNumber = "",
      ownerName = "",
      botName = "",
      botPhoto = ""
    } = options
    const phoneNumber = normalizeJadiBotNumber(rawPhone)
    if (!phoneNumber) {
      return { ok: false, message: "Nomor tidak valid." }
    }
    const profile = {
      mode: normalizeJadiBotMode(mode),
      ownerNumber: normalizeJadiBotNumber(ownerNumber),
      ownerName: String(ownerName || "").trim(),
      phoneNumber,
      botName: String(botName || "").trim(),
      botPhoto: String(botPhoto || "").trim()
    }

    const existing = global.jadiBotClients.get(phoneNumber)
    if (existing && (existing.status === "starting" || existing.status === "open")) {
      if (notifyChat) global.jadiBotLastByChat.set(notifyChat, phoneNumber)
      if (!force) {
        return {
          ok: true,
          alreadyRunning: true,
          phoneNumber,
          status: existing.status,
          profile: existing.profile,
          message: `JadiBot ${phoneNumber} sudah berjalan.`
        }
      }
      await stopJadiBotClient(phoneNumber)
    }

    const sessionDir = path.join(jadiBotRootDir, phoneNumber)
    fs.mkdirSync(sessionDir, { recursive: true })
    writeJadiBotProfile(sessionDir, profile)

    let cloneSocket
    try {
      const { state: cloneState, saveCreds: saveCloneCreds } = await useMultiFileAuthState(sessionDir)
      cloneSocket = makeWASocket({
        logger: pino({ level: "silent" }),
        printQRInTerminal: false,
        auth: {
          creds: cloneState.creds,
          keys: makeCacheableSignalKeyStore(
            cloneState.keys,
            pino().child({ level: "silent", stream: "store" })
          )
        },
        version,
        browser: ["Ubuntu", "Chrome", "20.0.00"],
        syncFullHistory: true,
        markOnlineOnConnect: true,
        connectTimeoutMs: 90000,
        defaultQueryTimeoutMs: 0,
        keepAliveIntervalMs: 8000,
        generateHighQualityLinkPreview: true
      })

      cloneSocket.public = normalizeJadiBotMode(profile.mode) !== "push"
      cloneSocket.jadiBotProfile = profile
      attachSocketRuntime(cloneSocket, store)

      const stateObj = {
        socket: cloneSocket,
        status: "starting",
        notifyChat,
        reconnectTimer: null,
        sessionDir,
        hasOpened: false,
        hasSentSelfMenu: false,
        retryCount: 0,
        profile
      }
      global.jadiBotClients.set(phoneNumber, stateObj)
      if (notifyChat) global.jadiBotLastByChat.set(notifyChat, phoneNumber)

      cloneSocket.ev.on("creds.update", saveCloneCreds)
      cloneSocket.ev.on("messages.upsert", (chatUpdate) => processSocketMessages(cloneSocket, chatUpdate))
      cloneSocket.ev.on("connection.update", async (update) => {
        const { connection, lastDisconnect } = update
        const current = global.jadiBotClients.get(phoneNumber)
        if (!current || current.socket !== cloneSocket) return

        if (connection === "open") {
          current.status = "open"
          current.hasOpened = true
          current.retryCount = 0
          global.jadiBotRetryCount.delete(phoneNumber)
          const isPushMode = normalizeJadiBotMode(current.profile?.mode) === "push"
          if (isPushMode && !current.hasSentSelfMenu) {
            current.hasSentSelfMenu = true
            const selfJid = `${phoneNumber}@s.whatsapp.net`
            await cloneSocket.sendMessage(selfJid, {
              text: buildPushSelfMenuText(".")
            }).catch(() => {})
          }
          if (current.notifyChat) {
            await Alice.sendMessage(current.notifyChat, {
              text: `✅ JadiBot *${phoneNumber}* berhasil connect.`
            }).catch(() => {})
          }
        }

        if (connection === "close") {
          current.status = "close"
          if (current.manualStop) {
            global.jadiBotRetryCount.delete(phoneNumber)
            global.jadiBotClients.delete(phoneNumber)
            if (current.notifyChat) {
              const linked = global.jadiBotLastByChat.get(current.notifyChat)
              if (linked === phoneNumber) global.jadiBotLastByChat.delete(current.notifyChat)
            }
            await deleteJadiBotSession(current.sessionDir)
            return
          }
          const closeError = lastDisconnect?.error
          const reason = Number(
            closeError?.output?.statusCode ||
            closeError?.statusCode ||
            new Boom(closeError)?.output?.statusCode ||
            0
          )
          const closeMessage = String(
            closeError?.output?.payload?.message ||
            closeError?.message ||
            ""
          ).toLowerCase()
          if (current.reconnectTimer) clearTimeout(current.reconnectTimer)
          const isRegistered = !!cloneSocket.authState?.creds?.registered
          const shouldPreserveSession = isRegistered &&
            !closeMessage.includes("logged out") &&
            ![
              DisconnectReason.loggedOut,
              DisconnectReason.badSession,
              DisconnectReason.connectionReplaced,
              DisconnectReason.multideviceMismatch
            ].includes(reason)

          const scheduleReconnect = async ({
            maxRetry = 3,
            delayMs = 3000,
            requestPairing = false,
            reasonText = "disconnect",
            resetSessionBeforeRetry = false
          } = {}) => {
            const prev = Number(global.jadiBotRetryCount.get(phoneNumber) || 0)
            const next = prev + 1
            if (next > maxRetry) return false
            global.jadiBotRetryCount.set(phoneNumber, next)

            global.jadiBotClients.delete(phoneNumber)
            current.reconnectTimer = setTimeout(async () => {
              try {
                if (resetSessionBeforeRetry) {
                  await deleteJadiBotSession(current.sessionDir)
                }
                const restartResult = await startJadiBotClient(phoneNumber, current.notifyChat, {
                  requestPairing,
                  preserveSessionOnError: true,
                  mode: current.profile?.mode || "standard",
                  ownerNumber: current.profile?.ownerNumber || "",
                  ownerName: current.profile?.ownerName || "",
                  botName: current.profile?.botName || "",
                  botPhoto: current.profile?.botPhoto || ""
                })
                if (current.notifyChat && requestPairing && restartResult?.ok) {
                  if (restartResult.pairingCode) {
                    await Alice.sendMessage(current.notifyChat, {
                      text: `🔐 Pairing Code Baru *${phoneNumber}*: *${restartResult.pairingCode}*`
                    }).catch(() => {})
                  } else if (!restartResult.sessionRegistered) {
                    await Alice.sendMessage(current.notifyChat, {
                      text: `⏳ Pairing *${phoneNumber}* masih diproses. Tunggu beberapa detik.`
                    }).catch(() => {})
                  }
                }
              } catch (e) {
                console.log("JadiBot retry error:", e?.message || e)
              }
            }, delayMs)

            if (current.notifyChat) {
              await Alice.sendMessage(current.notifyChat, {
                text: `⚠️ JadiBot *${phoneNumber}* terputus (${reasonText}).\nMencoba reconnect otomatis (${next}/${maxRetry})...`
              }).catch(() => {})
            }
            return true
          }

          // Jika belum sempat pairing/open, perlakukan disconnect awal sebagai retry pairing
          if (!current.hasOpened && !isRegistered) {
            const retried = await scheduleReconnect({
              maxRetry: jadiBotInitPairingRetryMax,
              delayMs: 7000,
              requestPairing: true,
              reasonText: "inisialisasi pairing belum selesai",
              resetSessionBeforeRetry: true
            })
            if (retried) return

            global.jadiBotRetryCount.delete(phoneNumber)
            global.jadiBotClients.delete(phoneNumber)
            await deleteJadiBotSession(current.sessionDir)
            if (current.notifyChat) {
              const linked = global.jadiBotLastByChat.get(current.notifyChat)
              if (linked === phoneNumber) global.jadiBotLastByChat.delete(current.notifyChat)
              await Alice.sendMessage(current.notifyChat, {
                text: `⚠️ Pairing JadiBot *${phoneNumber}* belum berhasil setelah ${jadiBotInitPairingRetryMax}x percobaan otomatis.\nSession otomatis direset agar tidak bentrok.\nSilakan jalankan ulang *.jadibot ${phoneNumber}* untuk meminta pairing code baru.`
              }).catch(() => {})
            }
            return
          }

          const transientReasons = [
            DisconnectReason.connectionClosed,
            DisconnectReason.connectionLost,
            DisconnectReason.timedOut,
            DisconnectReason.restartRequired,
            DisconnectReason.unavailableService
          ]
          const isTransient = !reason || transientReasons.includes(reason)
          if (isTransient) {
            const retried = await scheduleReconnect({
              maxRetry: current.hasOpened ? jadiBotTransientRetryMaxWarm : jadiBotTransientRetryMaxCold,
              delayMs: jadiBotTransientRetryDelayMs,
              requestPairing: !isRegistered,
              reasonText: "koneksi tidak stabil"
            })
            if (retried) return
          }

          // Kadang status 401 terdeteksi sementara padahal sesi masih valid.
          const falseLogoutPattern = reason === DisconnectReason.loggedOut && isRegistered && !closeMessage.includes("logged out")
          if (falseLogoutPattern) {
            const retried = await scheduleReconnect({
              maxRetry: jadiBotFalseLogoutRetryMax,
              delayMs: jadiBotFalseLogoutRetryDelayMs,
              requestPairing: false,
              reasonText: "logout sementara (validasi ulang sesi)"
            })
            if (retried) return
          }

          global.jadiBotRetryCount.delete(phoneNumber)
          global.jadiBotClients.delete(phoneNumber)
          if (current.notifyChat) {
            const linked = global.jadiBotLastByChat.get(current.notifyChat)
            if (linked === phoneNumber) global.jadiBotLastByChat.delete(current.notifyChat)
          }
          if (!shouldPreserveSession) {
            await deleteJadiBotSession(current.sessionDir)
          }

          let reasonText = "disconnect"
          if (reason === DisconnectReason.loggedOut) reasonText = "logout"
          else if (reason === DisconnectReason.badSession) reasonText = "bad session"
          else if (reason === DisconnectReason.connectionClosed) reasonText = "connection closed"
          else if (reason === DisconnectReason.connectionLost) reasonText = "connection lost"
          else if (reason === DisconnectReason.timedOut) reasonText = "timed out"
          else if (reason === DisconnectReason.connectionReplaced) reasonText = "connection replaced"
          else if (reason === DisconnectReason.restartRequired) reasonText = "restart required"
          else if (reason === DisconnectReason.multideviceMismatch) reasonText = "multidevice mismatch"

          if (current.notifyChat) {
            await Alice.sendMessage(current.notifyChat, {
              text: shouldPreserveSession
                ? `⚠️ JadiBot *${phoneNumber}* terputus (${reasonText}).\nSession tetap disimpan supaya lebih aman.\nCoba jalankan ulang *.jadibot ${phoneNumber}* untuk reconnect tanpa pairing ulang jika sesi masih valid.`
                : `❌ JadiBot *${phoneNumber}* terputus (${reasonText}).\nSession otomatis dihapus.\nJalankan ulang .jadibot ${phoneNumber} untuk pairing baru.`
            }).catch(() => {})
          }
        }
      })

      const sessionRegistered = !!cloneSocket.authState?.creds?.registered
      let pairingCode = null
      if (requestPairing && !sessionRegistered) {
        const customPairingKey = normalizeCustomPairingKey(global.pairing)
        pairingCode = await requestMainPairingCodeWithRetry(
          cloneSocket,
          phoneNumber,
          customPairingKey,
          () => isSocketUnavailable(cloneSocket)
        )
      }

      let pairingMessage = "Pairing code belum tersedia, menunggu inisialisasi koneksi."
      if (pairingCode) pairingMessage = "Pairing code berhasil dibuat."
      else if (sessionRegistered) pairingMessage = "Sesi sudah terdaftar, menunggu koneksi."

      return {
        ok: true,
        phoneNumber,
        profile,
        sessionRegistered,
        pairingCode,
        message: pairingMessage
      }
    } catch (err) {
      global.jadiBotClients.delete(phoneNumber)
      global.jadiBotRetryCount.delete(phoneNumber)
      if (!preserveSessionOnError) {
        await deleteJadiBotSession(sessionDir)
      }
      const rawMessage = String(err?.message || "")
      const lowerMessage = rawMessage.toLowerCase()
      let friendlyMessage = rawMessage || "Gagal membuat sesi jadi bot."
      if (lowerMessage.includes("connection closed")) {
        friendlyMessage = "Connection Closed. Biasanya karena koneksi WhatsApp menutup pairing atau nomor target bentrok sesi aktif. Coba ulang .jadibot setelah 10-20 detik."
      } else if (lowerMessage.includes("websocket was closed before the connection was established")) {
        friendlyMessage = "WebSocket close saat inisialisasi pairing. Biasanya koneksi tidak stabil atau sesi bentrok. Coba ulang .jadibot setelah 10-20 detik."
      }
      return {
        ok: false,
        message: friendlyMessage
      }
    }
  }

  Alice.startJadiBot = async (phoneNumber, notifyChat = null, options = {}) => {
    return startJadiBotClient(phoneNumber, notifyChat, {
      requestPairing: true,
      mode: "standard",
      ownerNumber: options?.ownerNumber || "",
      ownerName: options?.ownerName || "",
      botName: options?.botName || "",
      botPhoto: options?.botPhoto || ""
    })
  }

  Alice.startJadiBotPush = async (phoneNumber, notifyChat = null, ownerNumber = "", ownerName = "", options = {}) => {
    return startJadiBotClient(phoneNumber, notifyChat, {
      requestPairing: true,
      mode: "push",
      ownerNumber,
      ownerName,
      botName: options?.botName || "",
      botPhoto: options?.botPhoto || ""
    })
  }

  Alice.listJadiBot = () => {
    return [...global.jadiBotClients.entries()].map(([number, state]) => ({
      number,
      status: state?.status || "unknown",
      mode: state?.profile?.mode || "standard",
      ownerNumber: state?.profile?.ownerNumber || ""
    }))
  }

  Alice.stopJadiBot = async (phoneNumber) => {
    return stopJadiBotClient(phoneNumber)
  }

  Alice.cancelJadiBot = async (phoneNumber) => {
    return stopJadiBotClient(phoneNumber)
  }

  Alice.getLastJadiBotByChat = (chatId) => {
    return global.jadiBotLastByChat.get(chatId) || null
  }

  const restoreJadiBotSessions = async () => {
    if (global.jadiBotRestoring) return
    global.jadiBotRestoring = true

    try {
      if (!fs.existsSync(jadiBotRootDir)) return
      const entries = await fs.promises.readdir(jadiBotRootDir, { withFileTypes: true })
      const sessionNumbers = entries
        .filter((entry) => entry.isDirectory() && /^\d{10,16}$/.test(entry.name))
        .map((entry) => entry.name)

      if (!sessionNumbers.length) {
        console.log("[JadiBot] Tidak ada sesi tersimpan untuk direstore.")
        return
      }

      console.log(`[JadiBot] Memulai restore ${sessionNumbers.length} sesi...`)
      for (const number of sessionNumbers) {
        try {
          const sessionDir = path.join(jadiBotRootDir, number)
          const profile = readJadiBotProfile(sessionDir, number)
          const result = await startJadiBotClient(number, null, {
            requestPairing: false,
            preserveSessionOnError: true,
            mode: profile.mode,
            ownerNumber: profile.ownerNumber,
            ownerName: profile.ownerName
          })
          if (!result?.ok) {
            console.log(`[JadiBot] Restore ${number} gagal: ${result?.message || "unknown error"}`)
          } else if (result?.alreadyRunning) {
            console.log(`[JadiBot] ${number} sudah aktif, skip restore.`)
          } else {
            console.log(`[JadiBot] Restore ${number}: ${result?.message || "diproses"}`)
          }
        } catch (e) {
          console.log(`[JadiBot] Restore ${number} error:`, e?.message || e)
        }
        await new Promise((resolve) => setTimeout(resolve, 1200))
      }
      console.log("[JadiBot] Restore sesi selesai.")
    } catch (e) {
      console.log("[JadiBot] Restore gagal:", e?.message || e)
    } finally {
      global.jadiBotRestoring = false
    }
  }
//📈————————————————————————— [ © NICKY ] —————————————————————————📉\\

