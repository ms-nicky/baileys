//📈————————————————————————— [ © ANTI CALL ] —————————————————————————📉\\
let antiCallDB = {}
const antiCallLidToPn = new Map()
const normalizeAntiCallJid = (jid = '') => {
  const raw = String(jid || '').trim()
  if (!raw) return ''
  const decoded = typeof Alice.decodeJid === 'function' ? Alice.decodeJid(raw) : raw
  return String(decoded || raw).trim()
}
const isAntiCallLidJid = (jid = '') => normalizeAntiCallJid(jid).endsWith('@lid')
const isAntiCallPnJid = (jid = '') => normalizeAntiCallJid(jid).endsWith('@s.whatsapp.net')
const upsertAntiCallLidPn = (lidJid = '', pnJid = '') => {
  const lid = normalizeAntiCallJid(lidJid)
  const pn = normalizeAntiCallJid(pnJid)
  if (!isAntiCallLidJid(lid) || !isAntiCallPnJid(pn)) return
  antiCallLidToPn.set(lid, pn)
}
const hydrateAntiCallLidMapFromContacts = (contacts = []) => {
  for (const contact of Array.isArray(contacts) ? contacts : []) {
    if (!contact || typeof contact !== 'object') continue
    const id = normalizeAntiCallJid(contact.id || '')
    const lid = normalizeAntiCallJid(contact.lid || '')
    const jid = normalizeAntiCallJid(contact.jid || '')
    if (isAntiCallPnJid(id) && isAntiCallLidJid(lid)) upsertAntiCallLidPn(lid, id)
    if (isAntiCallLidJid(id) && isAntiCallPnJid(jid)) upsertAntiCallLidPn(id, jid)
  }
}
const resolveAntiCallCallerJid = (payload = {}) => {
  const fromJid = normalizeAntiCallJid(payload.from || '')
  const chatJid = normalizeAntiCallJid(payload.chatId || '')
  const directPn = [fromJid, chatJid].find((jid) => isAntiCallPnJid(jid))
  if (directPn) return directPn

  const lidCandidate = [fromJid, chatJid].find((jid) => isAntiCallLidJid(jid))
  if (!lidCandidate) return fromJid || chatJid || ''

  const mapped = normalizeAntiCallJid(antiCallLidToPn.get(lidCandidate) || '')
  if (isAntiCallPnJid(mapped)) return mapped

  const directContact = store?.contacts?.[lidCandidate] || null
  if (directContact) {
    const candidate = normalizeAntiCallJid(directContact.jid || directContact.id || '')
    if (isAntiCallPnJid(candidate)) {
      upsertAntiCallLidPn(lidCandidate, candidate)
      return candidate
    }
  }

  const allContacts = Object.values(store?.contacts || {})
  for (const contact of allContacts) {
    const contactId = normalizeAntiCallJid(contact?.id || '')
    const contactLid = normalizeAntiCallJid(contact?.lid || '')
    const contactJid = normalizeAntiCallJid(contact?.jid || '')
    if (contactLid === lidCandidate && isAntiCallPnJid(contactId)) {
      upsertAntiCallLidPn(lidCandidate, contactId)
      return contactId
    }
    if (contactId === lidCandidate && isAntiCallPnJid(contactJid)) {
      upsertAntiCallLidPn(lidCandidate, contactJid)
      return contactJid
    }
  }

  return lidCandidate
}
const resolveAntiCallCallerJidAsync = async (payload = {}) => {
  const resolved = resolveAntiCallCallerJid(payload)
  if (isAntiCallPnJid(resolved) || !isAntiCallLidJid(resolved)) return resolved
  try {
    if (typeof Alice.executeUSyncQuery !== 'function') return resolved
    const query = new USyncQuery().withLIDProtocol().withUser(new USyncUser().withId(resolved))
    const result = await Alice.executeUSyncQuery(query)
    const first = Array.isArray(result?.list) ? result.list[0] : null
    const candidateId = normalizeAntiCallJid(first?.id || '')
    if (isAntiCallPnJid(candidateId)) {
      upsertAntiCallLidPn(resolved, candidateId)
      return candidateId
    }
  } catch {}
  return resolved
}

hydrateAntiCallLidMapFromContacts(Object.values(store?.contacts || {}))

Alice.ev.on('messaging-history.set', ({ contacts = [] }) => {
  hydrateAntiCallLidMapFromContacts(contacts)
})
Alice.ev.on('contacts.upsert', (contacts = []) => {
  hydrateAntiCallLidMapFromContacts(contacts)
})
Alice.ev.on('chats.phoneNumberShare', ({ lid, jid }) => {
  upsertAntiCallLidPn(lid, jid)
})

const formatAntiCallWib = (inputDate = new Date()) => {
  const date = inputDate instanceof Date ? inputDate : new Date(inputDate)
  const parts = new Intl.DateTimeFormat('id-ID', {
    timeZone: 'Asia/Jakarta',
    day: '2-digit',
    month: '2-digit',
    year: 'numeric',
    hour: '2-digit',
    minute: '2-digit',
    second: '2-digit',
    hour12: false
  }).formatToParts(date).reduce((acc, part) => {
    if (part.type !== 'literal') acc[part.type] = part.value
    return acc
  }, {})
  const d = parts.day || '00'
  const m = parts.month || '00'
  const y = parts.year || '0000'
  const h = parts.hour || '00'
  const i = parts.minute || '00'
  const s = parts.second || '00'
  return `${d}/${m}/${y}, ${h}:${i}:${s} WIB`
}
const normalizeAntiCallNumber = (jid = '') => {
  const raw = normalizeAntiCallJid(jid)
  if (!raw) return '-'
  const bare = String(raw).replace(/@.+$/, '').trim()
  const digits = bare.replace(/[^0-9]/g, '')
  return digits || bare || raw
}

Alice.ev.on('call', async (call) => {
   if (!global.anticall) return
   try {
      const payload = call?.[0] || {}
      const fromTarget = normalizeAntiCallJid(payload.from || payload.chatId || '')
      const id = payload.id
      const status = payload.status
      const resolvedCallerJid = await resolveAntiCallCallerJidAsync(payload)
      const callerNumber = normalizeAntiCallNumber(resolvedCallerJid || fromTarget)
      const callCounterKey = resolvedCallerJid || fromTarget || callerNumber

      if (status === "offer") {
         console.log(`📞 Panggilan terdeteksi dari: ${callerNumber}`)

         // tolak panggilan
         if (id && fromTarget) await Alice.rejectCall(id, fromTarget)

         // simpan jumlah panggilan
         if (!antiCallDB[callCounterKey]) antiCallDB[callCounterKey] = 1
         else antiCallDB[callCounterKey] += 1

         // === Kirim laporan ke owner ===
         let laporan =
`📞 *ANTI CALL REPORT*

Nomor : ${callerNumber}
Total Call : ${antiCallDB[callCounterKey]}x
Waktu : ${formatAntiCallWib(payload.date || new Date())}`

         for (let i of global.owner) {
            await Alice.sendMessage(i + "@s.whatsapp.net", { text: laporan })
         }

         // block otomatis jika spam call
         if (antiCallDB[callCounterKey] >= 3) {
            const blockTargets = [...new Set([resolvedCallerJid, fromTarget].map((jid) => normalizeAntiCallJid(jid)).filter(Boolean))]
            for (const blockJid of blockTargets) {
              try {
                await Alice.updateBlockStatus(blockJid, "block")
                break
              } catch {}
            }
            console.log(`🚫 ${callerNumber} diblokir karena spam call.`)

            for (let i of global.owner) {
               await Alice.sendMessage(i + "@s.whatsapp.net", { 
                  text: `🚫 Nomor ${callerNumber} diblokir otomatis karena spam call (≥3x).`
               })
            }
         }
      }
   } catch (e) {
      console.error("❌ Error AntiCall:", e)
   }
})
