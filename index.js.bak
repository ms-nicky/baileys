const normalizeCustomPairingKey = (value) => {
  const normalized = String(value || '')
    .toUpperCase()
    .replace(/[^A-Z0-9]/g, '')
    .trim()

  if (!normalized) return null
  if (normalized.length !== 8) return null
  return normalized
}

global.__mainAliceSocket = global.__mainAliceSocket || null
