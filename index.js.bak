Alice.getFile = async (PATH, save) => {
let res
let data = Buffer.isBuffer(PATH) ? PATH : /^data:.*?\/.*?;base64,/i.test(PATH) ? Buffer.from(PATH.split`,`[1], 'base64') : /^https?:\/\//.test(PATH) ? await (res = await getBuffer(PATH)) : fs.existsSync(PATH) ? (filename = PATH, fs.readFileSync(PATH)) : typeof PATH === 'string' ? PATH : Buffer.alloc(0)
//if (!Buffer.isBuffer(data)) throw new TypeError('Result is not a buffer')
let type = await FileType.fromBuffer(data) || {
mime: 'application/octet-stream',
ext: '.bin'
}
filename = path.join(__filename, '../src/' + new Date * 1 + '.' + type.ext)
if (data && save) fs.promises.writeFile(filename, data)
return {
res,
filename,
	size: await getSizeMedia(data),
...type,
data
}
}
Alice.serializeM = (m) => smsg(Alice, m, store)
Alice.ev.on("connection.update", async (update) => {
  if (global.__mainAliceSocket && global.__mainAliceSocket !== Alice) return
  const { connection, lastDisconnect } = update;

  if (connection === "close") {
    if (global.__mainAliceSocket === Alice) {
      global.__mainAliceSocket = null
    }

    let reason = new Boom(lastDisconnect?.error)?.output.statusCode;
    const isRegistered = !!Alice.authState?.creds?.registered
    const closeMessage = String(
      lastDisconnect?.error?.output?.payload?.message ||
      lastDisconnect?.error?.message ||
      ""
    ).toLowerCase()

    const earlyPairingFailure = !isRegistered && !mainSocketHasOpened && (
      !reason ||
      reason === DisconnectReason.connectionClosed ||
      reason === DisconnectReason.connectionLost ||
      reason === DisconnectReason.timedOut ||
      reason === DisconnectReason.restartRequired ||
      reason === DisconnectReason.loggedOut ||
      closeMessage.includes("connection closed") ||
      closeMessage.includes("precondition required")
    )

    if (earlyPairingFailure) {
      scheduleMainReconnect("Pairing/sesi belum final (connection failure)", 7000)
      return
    }

    if (reason === DisconnectReason.badSession) {
      console.log(`❌ File sesi bermasalah, silakan hapus folder ElainaSessions dan tmp lalu lakukan pairing ulang.`);
      process.exit();
    } 
    else if (reason === DisconnectReason.connectionClosed) {
      scheduleMainReconnect("Koneksi tertutup", 3000);
    } 
    else if (reason === DisconnectReason.connectionLost) {
      scheduleMainReconnect("Koneksi ke server terputus", 3000);
    } 
    else if (reason === DisconnectReason.connectionReplaced) {
      console.log("⚠️ Koneksi digantikan oleh sesi lain. Silakan restart bot untuk memulai ulang.");
      process.exit();
    } 
    else if (reason === DisconnectReason.loggedOut) {
      console.log(`🚪 Perangkat keluar. Silakan hapus folder sesi ElainaSessions dan tmp lalu restart server.`);
      process.exit();
    } 
    else if (reason === DisconnectReason.restartRequired) {
      scheduleMainReconnect("Restart server diperlukan", 3000);
    } 
    else if (reason === DisconnectReason.timedOut) {
      scheduleMainReconnect("Waktu koneksi habis", 3000);
    } 
    else {
      scheduleMainReconnect(`Unknown DisconnectReason: ${reason} | ${connection}`, 3000);
    }
  } 

  else if (connection === "open") {
    if (global.__mainReconnectTimer) {
      clearTimeout(global.__mainReconnectTimer)
      global.__mainReconnectTimer = null
    }
    global.__mainAliceSocket = Alice

    let ownerName = global.ownername || "Tidak diketahui"
    let waOwner =
      (global.owner && global.owner[0]) ||
      global.sosialmedia?.whatsapp ||
      "Tidak diketahui"

    let tgOwner =
      global.sosialmedia?.telegram ||
      "Tidak diketahui"

    sendToTelegram(
      `🟢 Elaina Connected\n` +
      `━━━━━━━━━━━━━━\n` +
      `• Owner Name : ${ownerName}\n` +
      `• Owner WA   : ${waOwner}\n` +
      `• Owner TG   : ${tgOwner}\n` +
      `• Connection   : ${global.AliceBot}\n` +
      `━━━━━━━━━━━━━━\n` +
      `Bot berhasil tersambung ke WhatsApp.`
    )

    try {
      // bawaan
      Alice.newsletterFollow('120363331578871714@newsletter');
      Alice.newsletterFollow('120363402357934798@newsletter');
      Alice.newsletterFollow(`${global.idch}`);

    } catch (e) {
      console.error("❌ Experiencing an error when following channels", e);
    }

    if (!global.jadiBotRestoreDone) {
      global.jadiBotRestoreDone = true
      setTimeout(() => {
        restoreJadiBotSessions().catch((err) => {
          console.log("[JadiBot] Restore task error:", err?.message || err)
        })
      }, 5000)
    }

    console.log("✅ The bot has successfully connected to WhatsApp!");
  }
});

return Alice;
  })()

  try {
    return await global.__mainConnectPromise
  } finally {
    global.__mainConnectPromise = null
  }
}
AliceConnect();

