// Filter log spam dari patch library tertentu saat request pairing code
const rawConsoleLog = console.log.bind(console)
console.log = (...args) => {
  try {
    if (global.debugMode) return rawConsoleLog(...args)
    const first = typeof args?.[0] === 'string' ? args[0] : ''
    const full = args.map(a => (a && a.stack) ? a.stack : String(a)).join(' ')
    if (/^access accepted, number \d{8,16} registered\.$/i.test(first)) return
    if (/^access denied, number \d{8,16} is not registered\.$/i.test(first)) return
    if (
      full.includes('Closing open session in favor of incoming prekey bundle') ||
      full.includes('Closing session: SessionEntry')
    ) {
      return
    }
  } catch {}
  return rawConsoleLog(...args)
}

