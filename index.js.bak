const toUnixPath = (value = '') => String(value).replace(/\\/g, '/')

const readJsonSafe = (filePath) => {
  try {
    return JSON.parse(fs.readFileSync(filePath, 'utf8'))
  } catch {
    return null
  }
}

const walkJsonFiles = async (dirPath, acc = []) => {
  if (!fs.existsSync(dirPath)) return acc
  const entries = await fs.promises.readdir(dirPath, { withFileTypes: true })
  for (const entry of entries) {
    const fullPath = path.join(dirPath, entry.name)
    if (entry.isDirectory()) {
      await walkJsonFiles(fullPath, acc)
      continue
    }
    if (entry.isFile() && entry.name.toLowerCase().endsWith('.json')) {
      acc.push(fullPath)
    }
  }
  return acc
}

const escapeRegex = (text = '') => String(text).replace(/[.*+?^${}()|[\]\\]/g, '\\$&')

const normalizeRootPrefix = (value = '') => toUnixPath(value).replace(/\/+$/, '')

const collectionExists = async (db, collectionName = '') => {
  const name = String(collectionName || '').trim()
  if (!name) return false
  const collections = await db.listCollections({ name }, { nameOnly: true }).toArray()
  return collections.length > 0
}

const mapLegacyFilePath = (filePath = '', fromPrefix = '', toPrefix = '') => {
  const file = toUnixPath(filePath)
  const from = normalizeRootPrefix(fromPrefix)
  const to = normalizeRootPrefix(toPrefix)
  if (!from || !to || from === to) return file
  if (file === from) return to
  if (file.startsWith(`${from}/`)) return `${to}/${file.slice(from.length + 1)}`
  return file
}

const remapLegacyFileDocsInCollection = async ({ collectionName, fromPrefix, toPrefix }) => {
  if (!mongoose.connection || mongoose.connection.readyState !== 1 || !mongoose.connection.db) return { moved: 0, skipped: true }

  const from = normalizeRootPrefix(fromPrefix)
  const to = normalizeRootPrefix(toPrefix)
  if (!collectionName || !from || !to || from === to) return { moved: 0, skipped: true }
  if (!(await collectionExists(mongoose.connection.db, collectionName))) return { moved: 0, skipped: true }

  const collection = mongoose.connection.db.collection(collectionName)
  const regex = new RegExp(`^${escapeRegex(from)}(?:/|$)`)
  const docs = await collection.find({ kind: 'file', file: { $regex: regex } }).toArray()

  let moved = 0
  for (const doc of docs) {
    const oldFile = toUnixPath(doc.file || '')
    const newFile = mapLegacyFilePath(oldFile, from, to)
    if (!newFile || newFile === oldFile) continue

    const newDocId = `file::${newFile}`
    const replacement = {
      ...doc,
      _id: newDocId,
      key: newDocId,
      kind: 'file',
      file: newFile,
      updatedAt: new Date()
    }

    await collection.replaceOne({ _id: newDocId }, replacement, { upsert: true })
    if (String(doc._id || '') !== newDocId) {
      await collection.deleteOne({ _id: doc._id })
    }
    moved += 1
  }

  return { moved, skipped: false }
}

const isTargetCollectionSafeToReplace = async (collectionRef) => {
  const totalDocs = await collectionRef.countDocuments({})
  if (totalDocs === 0) return true
  if (totalDocs !== 1) return false

  const mainDoc = await collectionRef.findOne(
    { key: '__main__', kind: 'main' },
    { projection: { data: 1 } }
  )
  return !!mainDoc && !hasRuntimeData(mainDoc.data || {})
}

const migrateLegacyCollection = async ({ label, legacyCollection, targetCollection, legacyRootPrefix, targetRootPrefix }) => {
  if (!shouldUseMongoDb || !mongoAutoMigrateLegacyCollections) return
  if (!mongoose.connection || mongoose.connection.readyState !== 1 || !mongoose.connection.db) return

  const legacyName = String(legacyCollection || '').trim()
  const targetName = String(targetCollection || '').trim()
  if (!legacyName || !targetName) return

  const db = mongoose.connection.db
  const isSameCollection = legacyName === targetName
  const legacyExists = isSameCollection ? false : await collectionExists(db, legacyName)
  let targetExists = await collectionExists(db, targetName)

  if (!isSameCollection && legacyExists && !targetExists) {
    await db.collection(legacyName).rename(targetName)
    targetExists = true
    console.log(`[MongoDB] Rename koleksi ${label}: ${legacyName} -> ${targetName}`)
  } else if (!isSameCollection && legacyExists && targetExists) {
    const targetRef = db.collection(targetName)
    const canReplaceTarget = await isTargetCollectionSafeToReplace(targetRef)
    if (canReplaceTarget) {
      try {
        await targetRef.drop()
      } catch {}
      await db.collection(legacyName).rename(targetName)
      targetExists = true
      console.log(`[MongoDB] Replace koleksi kosong ${label}: ${legacyName} -> ${targetName}`)
    } else {
      const legacyRef = db.collection(legacyName)
      const legacyMain = await legacyRef.findOne({ key: '__main__', kind: 'main' }, { projection: { data: 1 } })
      const targetMain = await targetRef.findOne({ key: '__main__', kind: 'main' }, { projection: { data: 1 } })
      const canMergeMain = hasRuntimeData(legacyMain?.data || {}) && !hasRuntimeData(targetMain?.data || {})
      if (canMergeMain) {
        await targetRef.updateOne(
          { key: '__main__', kind: 'main' },
          { $set: { key: '__main__', kind: 'main', data: legacyMain.data } },
          { upsert: true }
        )
      }

      const legacyFileDocs = await legacyRef.find({ kind: 'file' }).toArray()
      let copiedFiles = 0
      for (const doc of legacyFileDocs) {
        const mappedFile = mapLegacyFilePath(doc.file || '', legacyRootPrefix, targetRootPrefix)
        if (!mappedFile) continue
        const mappedDocId = `file::${mappedFile}`
        const exists = await targetRef.findOne({ _id: mappedDocId }, { projection: { _id: 1 } })
        if (exists) continue

        await targetRef.replaceOne(
          { _id: mappedDocId },
          {
            ...doc,
            _id: mappedDocId,
            key: mappedDocId,
            kind: 'file',
            file: mappedFile,
            updatedAt: new Date()
          },
          { upsert: true }
        )
        copiedFiles += 1
      }

      if (canMergeMain || copiedFiles > 0) {
        console.log(`[MongoDB] Merge koleksi legacy ${label}: ${legacyName} -> ${targetName} (main=${canMergeMain ? 1 : 0}, file=${copiedFiles})`)
      }

      if (mongoDropLegacyCollections) {
        try {
          await legacyRef.drop()
          console.log(`[MongoDB] Koleksi legacy dihapus ${label}: ${legacyName}`)
        } catch (dropErr) {
          console.log(`[MongoDB] Gagal hapus koleksi legacy ${label} (${legacyName}): ${dropErr?.message || dropErr}`)
        }
      }
    }
  }

  if (!targetExists) return
  const remapResult = await remapLegacyFileDocsInCollection({
    collectionName: targetName,
    fromPrefix: legacyRootPrefix,
    toPrefix: targetRootPrefix
  })
  if (remapResult.moved > 0) {
    console.log(`[MongoDB] Update prefix dokumen ${label}: ${legacyRootPrefix} -> ${targetRootPrefix} (${remapResult.moved} dokumen)`)
  }
}

const migrateLegacyMongoCollections = async () => {
  if (!shouldUseMongoDb || !mongoAutoMigrateLegacyCollections) return

  const connectOptions = {
    useNewUrlParser: true,
    useUnifiedTopology: true,
    ...(mongoDbName ? { dbName: mongoDbName } : {})
  }

  if (!mongoose.connection || mongoose.connection.readyState !== 1) {
    await mongoose.connect(selectedDbUrl, connectOptions)
  }

  await migrateLegacyCollection({
    label: 'main',
    legacyCollection: mongoLegacyCollectionName,
    targetCollection: mongoCollectionName,
    legacyRootPrefix: mongoLegacyRootPrefix,
    targetRootPrefix: mongoRootPrefix
  })

  await migrateLegacyCollection({
    label: 'system',
    legacyCollection: mongoLegacySystemCollectionName,
    targetCollection: mongoSystemCollectionName,
    legacyRootPrefix: mongoLegacySystemRootPrefix,
    targetRootPrefix: mongoSystemRootPrefix
  })
}

const upsertMongoJsonFileDoc = async (collectionName, relativeFilePath, data) => {
  const collection = mongoose.connection.db.collection(collectionName)
  const file = toUnixPath(relativeFilePath)
  const docId = `file::${file}`
  await collection.updateOne(
    { _id: docId },
    {
      $set: {
        key: docId,
        kind: 'file',
        file,
        data,
        updatedAt: new Date()
      }
    },
    { upsert: true }
  )
}

const cleanupDeletedMongoJsonDocs = async (collectionName, rootPrefix, currentFileSet) => {
  const collection = mongoose.connection.db.collection(collectionName)
  const prefix = toUnixPath(rootPrefix).replace(/\/+$/, '')
  const regex = new RegExp(`^${escapeRegex(prefix)}/`)
  const docs = await collection.find(
    { kind: 'file', file: { $regex: regex } },
    { projection: { _id: 1, file: 1 } }
  ).toArray()

  let removed = 0
  for (const doc of docs) {
    const file = toUnixPath(doc.file || '')
    if (currentFileSet.has(file)) continue
    await collection.deleteOne({ _id: doc._id })
    removed += 1
  }
  return removed
}

const countMongoJsonDocsByRoot = async (collectionName, rootPrefix) => {
  if (!mongoose.connection || mongoose.connection.readyState !== 1) return 0
  const collection = mongoose.connection.db.collection(collectionName)
  const prefix = toUnixPath(rootPrefix).replace(/\/+$/, '')
  const regex = new RegExp(`^${escapeRegex(prefix)}/`)
  return collection.countDocuments({ kind: 'file', file: { $regex: regex } })
}

const syncJsonRootToMongo = async ({ rootDir, rootPrefix, collection }, options = {}) => {
  const { skipIfMongoHasDocs = false } = options
  if (skipIfMongoHasDocs) {
    const mongoDocs = await countMongoJsonDocsByRoot(collection, rootPrefix)
    if (mongoDocs > 0) return { upserted: 0, removed: 0, skipped: true, reason: 'mongo_has_data', mongoDocs }
  }
  if (!fs.existsSync(rootDir)) return { upserted: 0, removed: 0, skipped: true }

  const files = await walkJsonFiles(rootDir)
  const currentFileSet = new Set()
  let upserted = 0

  for (const filePath of files) {
    const relPath = toUnixPath(path.relative(__dirname, filePath))
    currentFileSet.add(relPath)
    const jsonData = readJsonSafe(filePath)
    if (jsonData === null) continue
    await upsertMongoJsonFileDoc(collection, relPath, jsonData)
    upserted += 1
  }

  const removed = await cleanupDeletedMongoJsonDocs(collection, rootPrefix, currentFileSet)
  return { upserted, removed, skipped: false }
}

const cleanupRuntimeMainLocalDbFiles = () => {
  if (!mongoCleanupLocalJson) return { deleted: 0, skipped: runtimeLocalDbCandidates.length }
  const mongoData = global.db.data && typeof global.db.data === 'object' ? global.db.data : {}
  if (!hasRuntimeData(mongoData)) {
    return { deleted: 0, skipped: runtimeLocalDbCandidates.length }
  }

  let deleted = 0
  let skipped = 0
  for (const filePath of runtimeLocalDbCandidates) {
    try {
      if (!fs.existsSync(filePath)) {
        skipped += 1
        continue
      }
      fs.unlinkSync(filePath)
      deleted += 1
    } catch {
      skipped += 1
    }
  }
  return { deleted, skipped }
}

const cleanupLocalJsonRoot = async ({ rootDir, rootPrefix, collection }, options = {}) => {
  const { force = false } = options
  if (!fs.existsSync(rootDir)) return { root: rootPrefix, collection, deleted: 0, kept: 0, skipped: true }
  if (!mongoose.connection || mongoose.connection.readyState !== 1) return { root: rootPrefix, collection, deleted: 0, kept: 0, skipped: true }

  const files = await walkJsonFiles(rootDir)
  let deleted = 0
  let kept = 0
  const collectionRef = mongoose.connection.db.collection(collection)

  for (const filePath of files) {
    const relPath = toUnixPath(path.relative(__dirname, filePath))
    const docId = `file::${relPath}`
    let canDelete = force
    if (!canDelete) {
      const doc = await collectionRef.findOne({ _id: docId }, { projection: { _id: 1 } })
      canDelete = !!doc
    }

    if (!canDelete) {
      kept += 1
      continue
    }

    try {
      fs.unlinkSync(filePath)
      deleted += 1
    } catch {
      kept += 1
    }
  }

  return { root: rootPrefix, collection, deleted, kept, skipped: false }
}

const cleanupAllLocalJsonDatabases = async (options = {}) => {
  const { force = false, logSummary = false } = options
  if (!shouldUseMongoDb || !mongoCleanupLocalJson) return []

  const results = []
  for (const root of mongoMirrorRoots) {
    const res = await cleanupLocalJsonRoot(root, { force })
    results.push(res)
  }

  const mainCleanup = cleanupRuntimeMainLocalDbFiles()
  if (logSummary) {
    for (const item of results) {
      if (item.skipped) {
        console.log(`[MongoDB] Skip cleanup lokal ${item.root} (folder tidak ada / Mongo belum siap)`)
        continue
      }
      console.log(`[MongoDB] Cleanup lokal ${item.root} -> ${item.collection} (deleted=${item.deleted}, kept=${item.kept})`)
    }
    console.log(`[MongoDB] Cleanup main local DB file (deleted=${mainCleanup.deleted}, skipped=${mainCleanup.skipped})`)
  }
  return results
}

let mongoJsonMirrorRunning = false
let mongoJsonMirrorInterval = null
let mongoJsonFsBridge = null
const syncAllJsonDatabasesToMongo = async (options = {}) => {
  const { force = false, skipIfMongoHasDocs = false, logSummary = false } = options
  if (!shouldUseMongoDb) return []
  if (!force && !mongoMirrorJsonFiles) return []
  if (mongoJsonMirrorRunning) return
  if (!mongoose.connection || mongoose.connection.readyState !== 1) return

  mongoJsonMirrorRunning = true
  const results = []
  try {
    for (const root of mongoMirrorRoots) {
      const result = await syncJsonRootToMongo(root, { skipIfMongoHasDocs })
      results.push({ root: root.rootPrefix, collection: root.collection, ...result })
    }
    if (logSummary) {
      for (const item of results) {
        if (item.skipped && item.reason === 'mongo_has_data') {
          console.log(`[MongoDB] Skip migrasi ${item.root} -> ${item.collection} (mongo sudah ada ${item.mongoDocs} dokumen)`)
          continue
        }
        if (item.skipped) {
          console.log(`[MongoDB] Skip migrasi ${item.root} -> ${item.collection} (folder lokal tidak ditemukan)`)
          continue
        }
        console.log(`[MongoDB] Migrasi ${item.root} -> ${item.collection} sukses (upsert=${item.upserted}, removed=${item.removed})`)
      }
    }
  } catch (err) {
    console.log(`[MongoDB] Mirror JSON gagal: ${err?.message || err}`)
  } finally {
    mongoJsonMirrorRunning = false
  }
  return results
}

const startMongoJsonMirror = () => {
  if (!shouldUseMongoDb || !mongoMirrorJsonFiles) return
  if (mongoUseFsBridge) return
  if (mongoJsonMirrorInterval) clearInterval(mongoJsonMirrorInterval)
  mongoJsonMirrorInterval = setInterval(() => {
    syncAllJsonDatabasesToMongo()
  }, mongoMirrorIntervalMs)
}

const bootstrapDatabase = async () => {
  await migrateLegacyMongoCollections()
  await loadDatabase()
}

const bootstrapDatabaseMaintenance = async () => {
  await migrateRuntimeLocalDbToMongo()
  if (mongoBootstrapMigrateJson) {
    await syncAllJsonDatabasesToMongo({ force: true, skipIfMongoHasDocs: true, logSummary: true })
  }
  await cleanupAllLocalJsonDatabases({ force: mongoCleanupLocalJsonForce, logSummary: true })
  if (shouldUseMongoDb && mongoUseFsBridge) {
    mongoJsonFsBridge = await setupMongoJsonFsBridge({
      fs,
      mongoose,
      roots: mongoMirrorRoots,
      fallbackToLocal: false,
      verbose: false
    })
  }
  startMongoJsonMirror()
}

const bootstrapDatabasePromise = bootstrapDatabase().catch((err) => {
  console.log(`[MongoDB] Bootstrap database gagal: ${err?.message || err}`)
  return null
})

let bootstrapDatabaseMaintenancePromise = null
const ensureBootstrapDatabaseMaintenance = () => {
  if (bootstrapDatabaseMaintenancePromise) return bootstrapDatabaseMaintenancePromise

  bootstrapDatabaseMaintenancePromise = bootstrapDatabasePromise
    .then(async () => {
      await bootstrapDatabaseMaintenance()
      return true
    })
    .catch((err) => {
      console.log(`[MongoDB] Maintenance database gagal: ${err?.message || err}`)
      return false
    })

  return bootstrapDatabaseMaintenancePromise
}

const resolveBaileysStartupVersion = async () => {
  const timeoutMs = Number(global.baileysVersionTimeoutMs || process.env.BAILEYS_VERSION_TIMEOUT_MS || 10000)
  const fallbackVersion = Array.isArray(defaultBaileysVersion) && defaultBaileysVersion.length === 3
    ? defaultBaileysVersion
    : [2, 2404, 10]

  try {
    const latestInfo = await Promise.race([
      fetchLatestWaWebVersion(),
      new Promise((_, reject) => setTimeout(() => reject(new Error("timeout")), timeoutMs))
    ])
    if (Array.isArray(latestInfo?.version) && latestInfo.version.length === 3) {
      return latestInfo.version
    }
  } catch (err) {
    console.log(`[Startup] Gagal ambil versi dari WA Web: ${err?.message || err}`)
  }

  try {
    const latestInfo = await Promise.race([
      fetchLatestBaileysVersion(),
      new Promise((_, reject) => setTimeout(() => reject(new Error("timeout")), timeoutMs))
    ])
    if (Array.isArray(latestInfo?.version) && latestInfo.version.length === 3) {
      return latestInfo.version
    }
  } catch (err) {
    console.log(`[Startup] Gagal ambil versi dari GitHub: ${err?.message || err}`)
  }

  return fallbackVersion
}

