// Suppress noisy libsignal decrypt logs (Bad MAC) without hiding real errors
const __origConsoleError = console.error.bind(console)
console.error = (...args) => {
  try {
    if (global.debugMode) return __origConsoleError(...args)
    const msg = args.map(a => (a && a.stack) ? a.stack : String(a)).join(' ')
    if (
      msg.includes('Failed to decrypt message with any known session') ||
      msg.includes('Bad MAC') ||
      msg.includes('Closing open session in favor of incoming prekey bundle') ||
      msg.includes('Closing session: SessionEntry')
    ) {
      return
    }
  } catch {}
  return __origConsoleError(...args)
}
