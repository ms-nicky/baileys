const normalizeJadiBotMode = (value = "") => value === "push" ? "push" : "standard"
const normalizeJadiBotGroupJid = (value = "") => {
  const raw = String(value || "").trim()
  if (!raw) return ""
  if (raw.endsWith("@g.us")) return raw
  if (/^[0-9-]+$/.test(raw)) return `${raw}@g.us`
  return raw
}
const getJadiBotMainBotOnlyGroups = () => {
