const runtimeLocalDbCandidates = [
  path.join(__dirname, 'ElainaDatabase', 'database.json'),
  path.join(__dirname, 'src', 'database.json')
]
const hasRuntimeData = (value) => {
  if (!value || typeof value !== 'object') return false
  return Object.values(value).some((entry) => {
    if (!entry) return false
    if (Array.isArray(entry)) return entry.length > 0
    if (typeof entry === 'object') return Object.keys(entry).length > 0
    return true
  })
}

const readRuntimeLocalDb = () => {
  for (const filePath of runtimeLocalDbCandidates) {
    try {
      if (!fs.existsSync(filePath)) continue
      const raw = JSON.parse(fs.readFileSync(filePath, 'utf8'))
      const data = raw && typeof raw === 'object' ? raw : {}
      if (hasRuntimeData(data)) return data
    } catch {}
  }
  return {}
}

const migrateRuntimeLocalDbToMongo = async () => {
  if (!shouldUseMongoDb) return
  if (mongoRuntimeConfig.migrate_local_db === false) return
  const localData = readRuntimeLocalDb()
  if (!hasRuntimeData(localData)) return

  const mongoData = global.db.data && typeof global.db.data === 'object' ? global.db.data : {}
  if (hasRuntimeData(mongoData)) return

  global.db.data = {
    ...(mongoData || {}),
    ...(localData || {})
  }

  try {
    await global.db.write()
    console.log(`[MongoDB] Migrasi awal sukses -> db=${mongoDbName}, collection=${mongoCollectionName}`)
  } catch (err) {
    console.log(`[MongoDB] Migrasi awal gagal: ${err?.message || err}`)
  }
}

