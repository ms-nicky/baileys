const getMainDisconnectCode = (error) => {
  try {
    const boom = error instanceof Boom ? error : new Boom(error)
    const status = Number(
      boom?.output?.statusCode ||
      error?.output?.statusCode ||
      error?.statusCode ||
      error?.status ||
      0
    )
    return Number.isFinite(status) ? status : 0
  } catch {
    const status = Number(error?.output?.statusCode || error?.statusCode || error?.status || 0)
    return Number.isFinite(status) ? status : 0
  }
}

const isMainPairingTransientError = (error) => {
  const status = getMainDisconnectCode(error)
  if ([
    405,
    428,
    408,
    425,
    429,
    500,
    502,
    503,
    504,
    DisconnectReason.connectionClosed,
    DisconnectReason.connectionLost,
    DisconnectReason.timedOut,
    DisconnectReason.restartRequired
  ].includes(status)) return true

  const message = String(
    error?.output?.payload?.message ||
    error?.message ||
    ""
  ).toLowerCase()

  return [
    "connection closed",
    "precondition required",
    "connection lost",
    "timed out",
    "restart required",
    "bad gateway",
    "service unavailable"
  ].some((needle) => message.includes(needle))
}

const isSocketUnavailable = (socket) => {
  const state = Number(socket?.ws?.readyState)
  return state === 2 || state === 3
}

const waitForSocketPairingWindow = async (socket) => {
  try {
    if (typeof socket?.waitForConnectionUpdate === "function") {
      await Promise.race([
        socket.waitForConnectionUpdate((update) => {
          const connection = String(update?.connection || "")
          return connection === "connecting" || connection === "open"
        }),
        delay(1500)
      ])
      return
    }
  } catch {}

  await delay(1500)
}

const requestSocketPairingCode = async (socket, phoneNumber, customPairingKey) => {
  if (typeof socket?.requestPairingCode === "function") {
    return socket.requestPairingCode(phoneNumber, customPairingKey || undefined)
  }

  if (typeof socket?.requestPairingCodes === "function") {
    return customPairingKey
      ? socket.requestPairingCodes(phoneNumber, customPairingKey)
      : socket.requestPairingCodes(phoneNumber)
  }

  throw new Error("Baileys build ini tidak mendukung pairing code")
}

const requestMainPairingCodeWithRetry = async (socket, phoneNumber, customPairingKey, isClosed) => {
  const retryDelays = [2500, 5000, 8000]
  let lastError = null

  await waitForSocketPairingWindow(socket)

  for (let attempt = 0; attempt <= retryDelays.length; attempt++) {
    if (typeof isClosed === "function" && isClosed()) {
      break
    }

    try {
      return await requestSocketPairingCode(socket, phoneNumber, customPairingKey)
    } catch (error) {
      lastError = error
      const hasRetryLeft = attempt < retryDelays.length

      if (!hasRetryLeft || !isMainPairingTransientError(error)) {
        break
      }

      console.log(`[MainBot] Pairing code belum siap, retry ${attempt + 1}/${retryDelays.length}...`)
      await delay(retryDelays[attempt])
    }
  }

  throw lastError || new Error("Connection Closed")
}

const scheduleMainReconnect = (reasonText = "koneksi utama terputus", delayMs = 3000) => {
  if (global.__mainReconnectTimer) return

  console.log(`[MainBot] ${reasonText}, mencoba koneksi ulang...`)
  global.__mainReconnectTimer = setTimeout(() => {
    global.__mainReconnectTimer = null
    AliceConnect().catch((error) => {
      console.log("[MainBot] Reconnect error:", error?.message || error)
    })
  }, delayMs)
}

